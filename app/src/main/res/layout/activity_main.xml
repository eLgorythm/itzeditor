<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnNew"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_new"
            android:src="@drawable/ic_new"
            android:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnOpen"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_open"
            android:src="@drawable/ic_open"
            android:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnSave"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_save"
            android:src="@drawable/ic_save"
            android:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnUndo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_undo"
            android:src="@drawable/ic_undo"
            android:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnRedo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_redo"
            android:src="@drawable/ic_redo"
            android:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnFind"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_find"
            android:src="@drawable/ic_search"
            android:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnMore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_more"
            android:tint="@color/text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Tab strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="8dp" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnNewTab"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_new"
            android:src="@drawable/ic_new"
            android:tint="@color/text_muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Find & replace bar -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etFind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_find"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFindCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/find_prev"
                android:src="@drawable/ic_prev"
                android:tint="@color/text_muted" />

            <ImageButton
                android:id="@+id/btnFindNext"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/find_next"
                android:src="@drawable/ic_next"
                android:tint="@color/text_muted" />

            <ImageButton
                android:id="@+id/btnFindClose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/btn_close"
                android:src="@drawable/ic_close"
                android:tint="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replaceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etReplace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_replace"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnReplace"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/find_replace"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnReplaceAll"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/find_replace_all"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbCase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_case"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbWholeWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_whole_word"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbRegex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_regex"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/findDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:visibility="gone" />

    <!-- Editor area: ScrollView yang menggulir gutter + editor bersama.
         Scroll internal EditText sengaja tidak dipakai (berat, tanpa momentum);
         ScrollView bawaan memberi fling native yang mulus. -->
    <ScrollView
        android:id="@+id/editorScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/editorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/gutterClip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvLineNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="16dp"
                    android:textColor="@color/text_faint" />
            </FrameLayout>

            <View
                android:id="@+id/gutterDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/border" />

            <me.fndlabs.itzeditor.editor.EditorView
                android:id="@+id/etEditor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/hint_editor"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:paddingTop="16dp"
                android:paddingBottom="48dp"
                android:scrollbars="none"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvStatusLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStatusRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
